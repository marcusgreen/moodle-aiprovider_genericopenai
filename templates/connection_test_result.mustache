{{!
    @template aiprovider_genericopenai/connection_test_result

    The result of a connection test.

    Context variables required for this template:
    * success - Whether the models were listed.
    * message - The result message.
    * warnings - Warning messages.
    * models - Model names listed by the server.
    * hasmodels - Whether any models were listed.

    Example context (json):
    {
        "success": true,
        "message": "Connection successful. The server lists 2 models.",
        "warnings": ["The model llama3 used by Generate text is not listed by the server."],
        "models": ["gpt-4o", "gpt-4o-mini"],
        "hasmodels": true
    }
}}
<div class="alert {{#success}}alert-success{{/success}}{{^success}}alert-danger{{/success}} mb-2" role="status">
    {{message}}
</div>
{{#warnings}}
<div class="alert alert-warning mb-2">{{.}}</div>
{{/warnings}}
{{#hasmodels}}
<details>
    <summary>{{#str}} connectiontest:models, aiprovider_genericopenai {{/str}}</summary>
    <ul class="mb-0 mt-2">
        {{#models}}
        <li><code>{{.}}</code></li>
        {{/models}}
    </ul>
</details>
{{/hasmodels}}
