{{!
    @template aiprovider_genericopenai/connection_test

    Button to test the connection of a saved provider instance, and the region for the result.

    Context variables required for this template:
    * providerid - The provider instance id.

    Example context (json):
    {
        "providerid": 1
    }
}}
<div class="aiprovider_genericopenai-connectiontest mb-3" data-region="aiprovider_genericopenai-connectiontest">
    <button type="button" class="btn btn-secondary" data-action="aiprovider_genericopenai-testconnection"
            data-providerid="{{providerid}}">
        {{#str}} connectiontest, aiprovider_genericopenai {{/str}}
    </button>
    <div class="form-text text-muted">{{#str}} connectiontest_desc, aiprovider_genericopenai {{/str}}</div>
    <div class="mt-2" data-region="aiprovider_genericopenai-connectiontest-result" aria-live="polite"></div>
</div>
